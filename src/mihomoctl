    "MIHOMOCTL_TIMER_UNIT", "/etc/systemd/system/mihomo-update.timer"
))
MAX_SUBSCRIPTION_BYTES = 128 * 1024 * 1024

# Exit codes
EXIT_OK = 0
EXIT_GENERAL = 1
EXIT_NOT_FOUND = 2
EXIT_API_DOWN = 3
EXIT_AUTH_FAILED = 4
EXIT_INVALID_INPUT = 5
EXIT_DEPENDENCY = 6

POLICY_GROUP_TYPES = {
    "selector", "urltest", "fallback", "loadbalance", "relay",
}
SELECTOR_GROUP_TYPES = {"selector", "select"}
PINNABLE_GROUP_TYPES = {"urltest", "fallback"}
NON_TESTABLE_PROXIES = {
    "DIRECT", "REJECT", "REJECT-DROP", "PASS", "COMPATIBLE",
}
_OPERATION_LOCK_FD = None


def die(msg, code=EXIT_GENERAL):
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def need_root(action):
    if os.geteuid() != 0:
        die(f"{action} needs root. Run: sudo mihomoctl ...", EXIT_DEPENDENCY)


@contextmanager
def operation_lock():
    """Serialize state/config mutations across CLI and timer processes."""
    global _OPERATION_LOCK_FD
    if _OPERATION_LOCK_FD is not None:
        yield
        return

    VAR.mkdir(parents=True, exist_ok=True)
    # Lock the directory inode itself. Unlike a user-writable lock path, it
    # cannot be swapped for a symlink to a privileged file between root calls.
    fd = os.open(
        VAR,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        _OPERATION_LOCK_FD = fd
        yield
    finally:
        _OPERATION_LOCK_FD = None
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def _stage_text(path, content, mode=0o600, preserve_owner=False):
    """Write and fsync a temporary sibling of path, returning its Path."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temp_path = Path(temp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temp_path, mode)

        if preserve_owner and os.geteuid() == 0:
            try:
                owner = path.stat()
            except FileNotFoundError:
                owner = path.parent.stat()
            os.chown(temp_path, owner.st_uid, owner.st_gid)
        return temp_path
    except Exception:
        temp_path.unlink(missing_ok=True)
        raise


def atomic_write_text(path, content, mode=0o600, preserve_owner=False):
    """Atomically replace path with content and explicit permissions."""
    path = Path(path)
    temp_path = _stage_text(path, content, mode, preserve_owner)
    try:
        os.replace(temp_path, path)
    finally:
        temp_path.unlink(missing_ok=True)


def read_regular_text(path, max_bytes):
    """Read a bounded regular file without following user-controlled symlinks."""
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(fd)
        if not stat.S_ISREG(metadata.st_mode):
            raise OSError(f"not a regular file: {path}")
        if metadata.st_size > max_bytes:
            raise OSError(f"file is too large: {path}")
        with os.fdopen(fd, "r", encoding="utf-8") as stream:
            fd = -1
            content = stream.read(max_bytes + 1)
            if len(content) > max_bytes:
                raise OSError(f"file grew too large while reading: {path}")
            return content
    finally:
        if fd >= 0:
            os.close(fd)


def get_controller_secret(create=False):
    """Read or create the local API credential shared by Mihomo and this CLI."""
    secret_path = VAR / "controller.secret"
    try:
        secret = read_regular_text(secret_path, 4096).strip()
        if secret:
            return secret
    except FileNotFoundError:
        pass
    except OSError as error:
        if not create:
            return ""
        die(f"cannot read controller secret: {error}", EXIT_GENERAL)

    if not create:
        return ""

    with operation_lock():
        try:
            secret = read_regular_text(secret_path, 4096).strip()
        except FileNotFoundError:
            secret = ""
        except OSError as error:
            die(f"cannot read controller secret: {error}", EXIT_GENERAL)
        if not secret:
            secret = secrets.token_urlsafe(32)
            atomic_write_text(
                secret_path,
                secret + "\n",
                mode=0o640,
                preserve_owner=True,
            )
        return secret


def load_yaml(path):
    try:
        content = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        die(f"{path} does not exist", EXIT_NOT_FOUND)
    except OSError as error:
        die(f"cannot read {path}: {error}", EXIT_GENERAL)
    try:
        data = yaml.safe_load(content) or {}
    except yaml.YAMLError as error:
        die(f"invalid YAML in {path}: {error}", EXIT_INVALID_INPUT)
    if not isinstance(data, dict):
        die(f"{path} is not a YAML object", EXIT_INVALID_INPUT)
    return data


def dump_yaml(data):
    return yaml.safe_dump(
        data,
        allow_unicode=True,
        sort_keys=False,
        default_flow_style=False,
    )


def save_yaml(path, data, mode=0o600):
    atomic_write_text(path, dump_yaml(data), mode=mode)


def controller_address():
    parsed = urllib.parse.urlsplit(CONTROLLER)
    if (
        parsed.scheme != "http"
        or parsed.hostname not in {"127.0.0.1", "localhost", "::1"}
        or parsed.username is not None
        or parsed.password is not None
        or parsed.path not in {"", "/"}
        or parsed.query
        or parsed.fragment
    ):
        die(
            "MIHOMOCTL_CONTROLLER must be an unauthenticated loopback HTTP URL",
            EXIT_INVALID_INPUT,
        )
    return parsed.netloc


def read_capture_mode():
    """Return the explicit host capture override, or None to inherit."""
    try:
        value = read_regular_text(CAPTURE_MODE, 64).strip()
    except FileNotFoundError:
        return None
    except OSError as error:
        die(f"cannot read {CAPTURE_MODE}: {error}", EXIT_GENERAL)
    if value not in {"tun", "proxy"}:
        die(
            f"invalid {CAPTURE_MODE}: expected 'tun' or 'proxy'",
            EXIT_INVALID_INPUT,
        )
    return value


def _ip_network(value):
    if not isinstance(value, str):
        return None
    try:
        return ipaddress.ip_network(value.strip(), strict=False)
    except ValueError:
        return None


def _subtract_networks(network, excluded_pools):
    """Return CIDRs for ``network`` minus same-family fake-IP pools."""
    fragments = [network]
    for pool in excluded_pools:
        if pool.version != network.version:
            continue
        remainder = []
        for fragment in fragments:
            if not fragment.overlaps(pool):
                remainder.append(fragment)
            elif fragment.subnet_of(pool):
                continue
            elif pool.subnet_of(fragment):
                remainder.extend(fragment.address_exclude(pool))
        fragments = remainder
    return fragments


def normalize_fake_ip_routes(cfg):
    """Keep active fake-IP pools inside Mihomo's auto-routed TUN ranges.

    Mihomo accepts a fake-IP pool covered by ``route-exclude-address`` but
    sing-tun then removes that pool from its routing table. DNS succeeds while
    application connections bypass the TUN and blackhole. Preserve every
    non-overlapping part of each subscription exclusion instead of dropping
    the whole CIDR.
    """
    tun = cfg.get("tun")
    dns = cfg.get("dns")
    if not isinstance(tun, dict) or not isinstance(dns, dict):
        return cfg
    if tun.get("enable") is not True or tun.get("auto-route") is not True:
        return cfg
    if dns.get("enable") is not True:
        return cfg
    if str(dns.get("enhanced-mode", "")).lower() != "fake-ip":
        return cfg

    pools = []
    fake_ipv4 = _ip_network(dns.get("fake-ip-range", "198.18.0.1/16"))
    if fake_ipv4 is not None and fake_ipv4.version == 4:
        pools.append(fake_ipv4)
    if cfg.get("ipv6") is True:
        fake_ipv6 = _ip_network(dns.get("fake-ip-range6"))
        if fake_ipv6 is not None and fake_ipv6.version == 6:
            pools.append(fake_ipv6)
    if not pools:
        return cfg

    for key in (
        "route-exclude-address",
        "inet4-route-exclude-address",
        "inet6-route-exclude-address",
    ):
        values = tun.get(key)
        if not isinstance(values, list):
            continue
        normalized = []
        for value in values:
            network = _ip_network(value)
            if network is None:
                normalized.append(value)
                continue
            fragments = _subtract_networks(network, pools)
            if len(fragments) == 1 and fragments[0] == network:
                normalized.append(value)
            else:
                normalized.extend(str(fragment) for fragment in fragments)
        tun[key] = normalized

    route_fields = (
        "route-address",
        "inet4-route-address",
        "inet6-route-address",
    )
    parsed_routes = []
    for key in route_fields:
        values = tun.get(key)
        if isinstance(values, list):
            parsed_routes.extend(
                network for value in values
                if (network := _ip_network(value)) is not None
            )

    route_address = tun.get("route-address")
    if route_address is None:
        route_address = []
    if isinstance(route_address, list):
        route_address = list(route_address)
        changed = False
        for pool in pools:
            same_family = [
                route for route in parsed_routes if route.version == pool.version
            ]
            if same_family and not any(pool.subnet_of(route) for route in same_family):
                route_address.append(str(pool))
                parsed_routes.append(pool)
                changed = True
        if changed:
            tun["route-address"] = route_address

    return cfg


def load_extra_rules():
    """Return persistent overlay rules from extra-rules.yaml (empty if absent)."""
    try:
        content = read_regular_text(EXTRA_RULES, 128 * 1024)
    except FileNotFoundError:
        return []
    except OSError as error:
        die(f"cannot read {EXTRA_RULES}: {error}", EXIT_GENERAL)
    try:
        data = yaml.safe_load(content)
    except yaml.YAMLError as error:
        die(f"invalid YAML in {EXTRA_RULES}: {error}", EXIT_INVALID_INPUT)
    if not isinstance(data, dict):
        die(f"{EXTRA_RULES} is not a YAML object", EXIT_INVALID_INPUT)
    rules = data.get("rules")
    if rules is None:
        return []
    if not isinstance(rules, list) or not all(
        isinstance(rule, str) for rule in rules
    ):
        die(f"{EXTRA_RULES} 'rules' must be a list of strings", EXIT_INVALID_INPUT)
    return rules


def merge_extra_rules(cfg):
    """Prepend persistent overlay rules so they beat subscription rules."""
    rules = load_extra_rules()
    if not rules:
        return cfg
    current = cfg.get("rules")
    if current is None:
        cfg["rules"] = list(rules)
    elif isinstance(current, list):
        cfg["rules"] = list(rules) + current
    else:
        die(
            "cannot merge overlay rules: subscription 'rules' is not a list",
            EXIT_INVALID_INPUT,
        )
    return cfg


def build_config(base_cfg, controller_secret="", capture_mode=None):
    """Apply deployment settings and native cross-field safety invariants."""
    cfg = copy.deepcopy(base_cfg)
    cfg["external-controller"] = controller_address()
    cfg["secret"] = controller_secret
    if capture_mode is not None:
        if capture_mode not in {"tun", "proxy"}:
            die("capture mode must be: tun, proxy, or inherit", EXIT_INVALID_INPUT)
        tun = cfg.get("tun")
        if tun is None:
            tun = {}
        elif not isinstance(tun, dict):
            die(
                "cannot override tun.enable because subscription 'tun' is not an object",
                EXIT_INVALID_INPUT,
            )
        else:
            tun = copy.deepcopy(tun)
        tun["enable"] = capture_mode == "tun"
        cfg["tun"] = tun
    return merge_extra_rules(normalize_fake_ip_routes(cfg))


def validate_config(path):
    subprocess.run(
        [MIHOMO_BIN, "-t", "-d", str(ETC), "-f", str(path)],
        check=True,
    )


def install_generated_config(cfg):
    """Validate a staged config before atomically replacing config.yaml."""
    with operation_lock():
        ETC.mkdir(parents=True, exist_ok=True, mode=0o700)
        staged = _stage_text(CFG, dump_yaml(cfg), mode=0o600)
        try:
            validate_config(staged)
            os.replace(staged, CFG)
        finally:
            staged.unlink(missing_ok=True)


def install_subscription(content, data, controller_secret=None):
    """Validate subscription-derived config before replacing active files."""
    with operation_lock():
        if controller_secret is None:
            controller_secret = get_controller_secret(create=True)
        cfg = build_config(data, controller_secret, read_capture_mode())
        ETC.mkdir(parents=True, exist_ok=True, mode=0o700)
        staged_base = _stage_text(BASE_CFG, content, mode=0o600)
        staged_cfg = _stage_text(CFG, dump_yaml(cfg), mode=0o600)
        backups = {}
        replaced = []
        try:
            validate_config(staged_cfg)
            for target in (BASE_CFG, CFG):
                if target.exists():
                    backups[target] = _stage_text(
                        target,
                        target.read_text(encoding="utf-8"),
                        mode=0o600,
                    )
                else:
                    backups[target] = None

            os.replace(staged_base, BASE_CFG)
            replaced.append(BASE_CFG)
            os.replace(staged_cfg, CFG)
            replaced.append(CFG)
        except Exception:
            for target in reversed(replaced):
                backup = backups.get(target)
                if backup is None:
                    target.unlink(missing_ok=True)
                else:
                    os.replace(backup, target)
            raise
        finally:
            staged_base.unlink(missing_ok=True)
            staged_cfg.unlink(missing_ok=True)
            for backup in backups.values():
                if backup is not None:
                    backup.unlink(missing_ok=True)


def generate_config(base_cfg=None):
    need_root("generating config")

    with operation_lock():
        base_cfg = load_yaml(BASE_CFG) if base_cfg is None else base_cfg
        cfg = build_config(
            base_cfg,
            get_controller_secret(create=True),
            read_capture_mode(),
        )
        install_generated_config(cfg)

    print(f"generated {CFG}")


def snapshot_runtime_files():
    """Capture files that must roll back together after a failed restart."""
    snapshots = {}
    specs = (
        (BASE_CFG, 0o600, False),
        (CFG, 0o600, False),
        (CAPTURE_MODE, 0o600, False),
        (EXTRA_RULES, 0o600, False),
        (VAR / "controller.secret", 0o640, True),
    )
    for path, mode, preserve_owner in specs:
        try:
            content = read_regular_text(path, 128 * 1024 * 1024)
        except FileNotFoundError:
            content = None
        snapshots[path] = (content, mode, preserve_owner)
    return snapshots


def restore_runtime_files(snapshots):
    for path, (content, mode, preserve_owner) in snapshots.items():
        if content is None:
            path.unlink(missing_ok=True)
        else:
            atomic_write_text(
                path,
                content,
                mode=mode,
                preserve_owner=preserve_owner,
            )


def http_json(method, path, body=None, timeout=8):
    controller_address()
    url = CONTROLLER + path
    data = None
    headers = {}

    if body is not None:
        data = json.dumps(body, ensure_ascii=False).encode()
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    controller = urllib.parse.urlsplit(CONTROLLER)
    if controller.hostname in {"127.0.0.1", "localhost", "::1"}:
        controller_secret = get_controller_secret(create=False)
        if controller_secret:
            # urllib does not copy unredirected headers to redirect requests.
            req.add_unredirected_header(
                "Authorization", f"Bearer {controller_secret}"
            )

    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read()
        if not raw:
            return None
        return json.loads(raw.decode())


def wait_api(timeout=20):
    end = time.time() + timeout
    last = None
    while time.time() < end:
        try:
            return http_json("GET", "/version")
        except urllib.error.HTTPError as error:
            code = error.code
            error.close()
            if code in {401, 403}:
                die(
                    "mihomo API rejected controller.secret; regenerate config",
                    EXIT_AUTH_FAILED,
                )
            die(f"mihomo API returned HTTP {code}", EXIT_API_DOWN)
        except Exception as e:
            last = e
            time.sleep(0.5)
    die(f"mihomo API is not responding at {CONTROLLER}: {last}", EXIT_API_DOWN)


def get_groups(wait=True):
    """Return policy groups keyed by name from Mihomo's native /group API."""
    if wait:
        wait_api()
    data = http_json("GET", "/group")
    items = data.get("proxies") if isinstance(data, dict) else None
    if not isinstance(items, list):
        die("bad /group response", EXIT_API_DOWN)

    groups = {}
    for item in items:
        if not isinstance(item, dict):
            continue
        name = item.get("name")
        if isinstance(name, str) and name:
            groups[name] = item
    return groups


def get_runtime_group(name):
    path = "/group/" + urllib.parse.quote(name, safe="")
    obj = http_json("GET", path)
    if not isinstance(obj, dict):
        die(f"bad runtime group response for: {name}", EXIT_API_DOWN)
    return obj


def group_members(obj):
    fallback = []
    for key in ("all", "proxies"):
        val = obj.get(key)
        if isinstance(val, list) and val:
            return val
        if isinstance(val, list):
            fallback = val
    return fallback


def group_type(obj):
    value = str(obj.get("type", "")).lower() if isinstance(obj, dict) else ""
    return re.sub(r"[^a-z0-9]", "", value)


def is_group(obj):
    if not isinstance(obj, dict):
        return False
    if any(isinstance(obj.get(key), list) for key in ("all", "proxies")):
        return True
    return group_type(obj) in POLICY_GROUP_TYPES


def is_selector(obj):
    return is_group(obj) and group_type(obj) in SELECTOR_GROUP_TYPES


def is_pinnable_group(obj):
    return is_group(obj) and group_type(obj) in PINNABLE_GROUP_TYPES


def visible_groups(groups, include_hidden=False):
    return [
        (name, obj)
        for name, obj in groups.items()
        if include_hidden or not bool(obj.get("hidden"))
    ]


def get_group_or_die(name, groups):
    obj = groups.get(name)
    if not is_group(obj):
        die(f"not a policy group: {name}", EXIT_NOT_FOUND)
    return obj


def validate_group_member(group, member, groups):
    obj = get_group_or_die(group, groups)
    if member not in group_members(obj):
        die(
            f"{member!r} is not an immediate member of {group!r}",
            EXIT_INVALID_INPUT,
        )
    return obj


def put_group_member(group, member):
    path = "/proxies/" + urllib.parse.quote(group, safe="")
    http_json("PUT", path, {"name": member})


def delete_group_pin(group):
    path = "/proxies/" + urllib.parse.quote(group, safe="")
    http_json("DELETE", path)


def get_group_leaf_proxies(group, groups):
    """Expand immediate group edges into unique, testable leaf proxies."""
    get_group_or_die(group, groups)
    leaves = []
    seen_leaves = set()

    def visit(name, ancestors):
        if name in NON_TESTABLE_PROXIES or name in ancestors:
            return
        obj = groups.get(name)
        if is_group(obj):
            for member in group_members(obj):
                visit(member, ancestors | {name})
            return
        if name not in seen_leaves:
            seen_leaves.add(name)
            leaves.append(name)

    visit(group, set())
    if not leaves:
        die(f"group has no testable leaf proxies: {group}", EXIT_NOT_FOUND)
    return leaves


def active_group_resolution(name, groups):
    """Resolve current ``now`` edges without pretending this is one global route."""
    chain = []
    seen = set()
    current = name
    terminal = None

    while True:
        if current in seen:
            terminal = f"cycle:{current}"
            break
        seen.add(current)
        chain.append(current)

        obj = groups.get(current)
        if not is_group(obj):
            break

        members = group_members(obj)
        now = obj.get("now")
        if not isinstance(now, str) or not now:
            if group_type(obj) == "loadbalance":
                terminal = "per-request"
            else:
                terminal = "no-active-edge"
            break
        if now not in members:
            chain.append(now)
            terminal = "inconsistent-runtime-edge"
            break
        current = now

    return chain, terminal


def format_group_resolution(name, obj, groups):
    chain, terminal = active_group_resolution(name, groups)
    flags = [str(obj.get("type", "unknown"))]
    if obj.get("hidden"):
        flags.append("hidden")
    if is_pinnable_group(obj):
        fixed = obj.get("fixed")
        flags.append(f"pinned={fixed}" if fixed else "auto")
    suffix = f" [{terminal}]" if terminal else ""
    return f"{' -> '.join(chain)}  ({', '.join(flags)}){suffix}"


def fzf_select(items, prompt):
    if shutil.which("fzf"):
        p = subprocess.run(
            ["fzf", "--prompt", prompt],
            input="\n".join(items) + "\n",
            text=True,
            stdout=subprocess.PIPE,
        )
        # Display prefixes carry state; only remove fzf's line terminator.
        result = p.stdout.rstrip("\r\n")
        return result if result else None
    else:
        for i, item in enumerate(items, 1):
            print(f"{i:2d}) {item}")
        try:
            idx = int(input("number: "))
            if 1 <= idx <= len(items):
                return items[idx - 1]
        except (ValueError, EOFError):
            pass
        return None


def fzf_select_value(options, prompt):
    """Select from ``(display, value)`` pairs without parsing display text."""
    result = fzf_select([display for display, _ in options], prompt)
    if result is None:
        return None
    for display, value in options:
        if display == result:
            return value
    return None


def test_proxy_latency(name):
    """Returns latency in ms or None on timeout."""
    try:
        path = f"/proxies/{urllib.parse.quote(name, safe='')}/delay"
        params = urllib.parse.urlencode({
            "timeout": 5000,
            "url": "http://www.gstatic.com/generate_204",
        })
        data = http_json("GET", f"{path}?{params}")
        return data.get("delay") if isinstance(data, dict) else None
    except Exception:
        return None


def effective_leaf_proxy(name, groups):
    chain, terminal = active_group_resolution(name, groups)
    if terminal:
