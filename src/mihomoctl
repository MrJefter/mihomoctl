def cmd_sub_update(args):
    need_root("updating subscription")

    try:
        url = SUB_URL.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        die("subscription URL missing. Run: sudo mihomoctl sub set", EXIT_NOT_FOUND)
    except OSError as error:
        die(f"cannot read subscription URL: {error}", EXIT_GENERAL)
    if not url:
        die("subscription URL is empty", EXIT_INVALID_INPUT)

    print("downloading subscription...")
    req = urllib.request.Request(url, headers={"User-Agent": "mihomo/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=60) as response:
            raw_content = response.read(MAX_SUBSCRIPTION_BYTES + 1)
    except (urllib.error.URLError, UnicodeDecodeError, OSError) as error:
        die(f"download failed: {error}", EXIT_API_DOWN)
    if len(raw_content) > MAX_SUBSCRIPTION_BYTES:
        die("downloaded subscription is too large", EXIT_INVALID_INPUT)
    try:
        content = raw_content.decode("utf-8")
    except UnicodeDecodeError as error:
        die(f"downloaded subscription is not UTF-8: {error}", EXIT_INVALID_INPUT)

    try:
        data = yaml.safe_load(content)
    except yaml.YAMLError as error:
        die(f"downloaded subscription is invalid YAML: {error}", EXIT_INVALID_INPUT)
    if not isinstance(data, dict):
        die("downloaded subscription is not a YAML object", EXIT_INVALID_INPUT)

    if not any(k in data for k in ("proxies", "proxy-providers", "proxy-groups", "rules")):
        die("downloaded file does not look like a Mihomo/Clash YAML config", EXIT_INVALID_INPUT)

    with operation_lock():
        if SUB_URL.read_text(encoding="utf-8").strip() != url:
            die(
                "subscription URL changed during download; run sub update again",
                EXIT_INVALID_INPUT,
            )
        was_active = service_is_active()
        snapshots = snapshot_runtime_files()
        committed = False
        try:
            install_subscription(content, data)
            committed = True
            if was_active:
                reload_runtime_config()
        except (Exception, SystemExit):
            if committed:
                try:
                    restore_runtime_files(snapshots)
                    if was_active:
                        reload_runtime_config()
                except (Exception, SystemExit) as rollback_error:
                    print(
                        f"warning: subscription rollback failed: {rollback_error}",
                        file=sys.stderr,
                    )
            raise

        print(f"saved: {BASE_CFG}")
        print(f"generated: {CFG}")

    print("subscription updated")


