    try:
        content = TIMER_UNIT.read_text(encoding="utf-8")
        m = re.search(r"OnUnitActiveSec=(.+)", content)
        if m:
            current = m.group(1).strip()
    except OSError:
        content = ""

    choices = ["1h", "2h", "4h", "6h", "12h", "24h", "custom"]
    options = [
        (f"{'* ' if choice == current else '  '}{choice}", choice)
        for choice in choices
    ]

    choice = fzf_select_value(options, "update cycle> ")
    if choice is None:
        raise SystemExit(EXIT_OK)

    if choice == "custom":
        if sys.stdin.isatty():
            choice = input("Enter interval (e.g., 30m, 2h, 1d): ").strip()
            if not choice:
                print("  aborted")
                raise SystemExit(EXIT_OK)
        else:
            die("custom interval requires interactive terminal", EXIT_INVALID_INPUT)

    # Parse interval to systemd format
    # Supported: Xm, Xh, Xd
    if not re.fullmatch(r"[1-9][0-9]*[mhd]", choice):
        die("interval must look like 30m, 2h, or 1d", EXIT_INVALID_INPUT)

    # Update timer unit
    with operation_lock():
        try:
            content = TIMER_UNIT.read_text(encoding="utf-8")
        except OSError as error:
            die(f"cannot read {TIMER_UNIT}: {error}", EXIT_GENERAL)
        new_content, replacements = re.subn(
            r"OnUnitActiveSec=.*",
            f"OnUnitActiveSec={choice}",
            content,
            count=1,
        )
        if replacements != 1:
            die(f"OnUnitActiveSec not found in {TIMER_UNIT}", EXIT_INVALID_INPUT)

        was_active = subprocess.run(
            [SYSTEMCTL, "is-active", "--quiet", "mihomo-update.timer"]
        ).returncode == 0
        atomic_write_text(TIMER_UNIT, new_content, mode=0o644)
        try:
            subprocess.run([SYSTEMCTL, "daemon-reload"], check=True)
            if was_active:
                subprocess.run(
                    [SYSTEMCTL, "restart", "mihomo-update.timer"], check=True
                )
        except Exception as error:
            try:
                atomic_write_text(TIMER_UNIT, content, mode=0o644)
                subprocess.run([SYSTEMCTL, "daemon-reload"], check=True)
                if was_active:
                    subprocess.run(
                        [SYSTEMCTL, "restart", "mihomo-update.timer"], check=True
                    )
            except Exception as rollback_error:
                print(
                    f"warning: timer rollback failed: {rollback_error}",
                    file=sys.stderr,
                )
            die(f"failed to update timer: {error}", EXIT_GENERAL)

    print(f"  update cycle set to: {choice}")


def cmd_logs(args):
    try:
        subprocess.run(["journalctl", "-u", "mihomo.service", "-f", "-o", "cat"])
    except KeyboardInterrupt:
        print()
        return


def main():
    p = argparse.ArgumentParser(prog="mihomoctl")

    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status").set_defaults(fn=cmd_status)

    group = sub.add_parser("group")
    group_sub = group.add_subparsers(dest="group_cmd", required=True)
    group_list = group_sub.add_parser("list")
    group_list.add_argument("--all", action="store_true")
    group_list.set_defaults(fn=cmd_group_list)
    group_show = group_sub.add_parser("show")
    group_show.add_argument("group")
    group_show.set_defaults(fn=cmd_group_show)
    group_select = group_sub.add_parser("select")
    group_select.add_argument("group")
    group_select.add_argument("member")
    group_select.set_defaults(fn=cmd_group_select)
    group_pin = group_sub.add_parser("pin")
    group_pin.add_argument("group")
    group_pin.add_argument("member")
    group_pin.set_defaults(fn=cmd_group_pin)
    group_unpin = group_sub.add_parser("unpin")
    group_unpin.add_argument("group")
    group_unpin.set_defaults(fn=cmd_group_unpin)

    route = sub.add_parser("route")
    route_sub = route.add_subparsers(dest="route_cmd", required=True)
    route_status = route_sub.add_parser("status")
    route_status.add_argument("roots", nargs="*")
    route_status.set_defaults(fn=cmd_route_status)
    route_pick = route_sub.add_parser("pick")
    route_pick.add_argument("root", nargs="?")
    route_pick.set_defaults(fn=cmd_route_pick)

    proxy = sub.add_parser("proxy")
    proxy_sub = proxy.add_subparsers(dest="proxy_cmd", required=True)
    proxy_test = proxy_sub.add_parser("test")
    proxy_test.add_argument("targets", nargs="+")
    proxy_test.add_argument("--all", action="store_true")
    proxy_test.set_defaults(fn=cmd_proxy_test)

    sub.add_parser("enable").set_defaults(fn=cmd_enable)
    sub.add_parser("disable").set_defaults(fn=cmd_disable)

    mode = sub.add_parser("mode")
    mode.add_argument("value", nargs="?", choices=("tun", "proxy", "inherit"))
    mode.set_defaults(fn=cmd_mode)

    s = sub.add_parser("sub")
    ssub = s.add_subparsers(dest="sub_cmd", required=True)

    ss = ssub.add_parser("set")
    ss.add_argument("url", nargs="?")
    ss.set_defaults(fn=cmd_sub_set)

    su = ssub.add_parser("update")
    su.set_defaults(fn=cmd_sub_update)

    sc = ssub.add_parser("cycle")
    sc.set_defaults(fn=cmd_sub_cycle)

    sub.add_parser("restart").set_defaults(fn=cmd_restart)
    sub.add_parser("logs").set_defaults(fn=cmd_logs)

    rules = sub.add_parser("rules")
    rules_sub = rules.add_subparsers(dest="rules_cmd", required=True)
    rules_sub.add_parser("list").set_defaults(fn=cmd_rules_list)
    rules_add = rules_sub.add_parser("add")
    rules_add.add_argument("rules", nargs="+")
    rules_add.set_defaults(fn=cmd_rules_add)
    rules_sub.add_parser("clear").set_defaults(fn=cmd_rules_clear)

    args = p.parse_args()
    try:
        args.fn(args)
    except urllib.error.HTTPError as error:
        code = error.code
        error.close()
        if code in {401, 403}:
            die(
                "mihomo API authentication failed; regenerate config with sudo mihomoctl restart",
                EXIT_AUTH_FAILED,
            )
        die(f"mihomo API request failed with HTTP {code}", EXIT_API_DOWN)
    except urllib.error.URLError as error:
        die(f"mihomo API is unavailable: {error.reason}", EXIT_API_DOWN)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        die(f"mihomo API returned an invalid response: {error}", EXIT_API_DOWN)
    except subprocess.CalledProcessError as error:
        command = error.cmd if isinstance(error.cmd, str) else " ".join(error.cmd)
        die(f"command failed with exit {error.returncode}: {command}", EXIT_GENERAL)
    except FileNotFoundError as error:
        die(f"required file or command not found: {error}", EXIT_DEPENDENCY)
    except PermissionError as error:
        die(f"permission denied: {error}", EXIT_DEPENDENCY)
    except KeyboardInterrupt:
        print(file=sys.stderr)
        raise SystemExit(130)


if __name__ == "__main__":
    main()
