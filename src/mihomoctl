def install_capture_config(capture_mode, cfg):
    """Validate and commit capture-mode plus its generated config."""
    ETC.mkdir(parents=True, exist_ok=True, mode=0o700)
    staged_cfg = _stage_text(CFG, dump_yaml(cfg), mode=0o600)
    staged_mode = None
    if capture_mode is not None:
        staged_mode = _stage_text(
            CAPTURE_MODE,
            capture_mode + "\n",
            mode=0o600,
        )
    try:
        validate_config(staged_cfg)
        if staged_mode is None:
            CAPTURE_MODE.unlink(missing_ok=True)
        else:
            os.replace(staged_mode, CAPTURE_MODE)
        os.replace(staged_cfg, CFG)
    finally:
        staged_cfg.unlink(missing_ok=True)
        if staged_mode is not None:
            staged_mode.unlink(missing_ok=True)


