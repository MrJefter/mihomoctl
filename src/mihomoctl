def tun_enabled(config):
    """Return the effective native tun.enable value from a config object."""
    if not isinstance(config, dict):
        die("bad Mihomo config response", EXIT_API_DOWN)
    tun = config.get("tun")
    if tun is None:
        return False
    if not isinstance(tun, dict):
        die("Mihomo config 'tun' is not an object", EXIT_INVALID_INPUT)
    value = tun.get("enable", False)
    if not isinstance(value, bool):
        die("Mihomo config 'tun.enable' is not boolean", EXIT_INVALID_INPUT)
    return value


