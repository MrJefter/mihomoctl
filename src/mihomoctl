def structural_route_roots(groups):
    incoming = set()
    for name, obj in groups.items():
        if name == "GLOBAL":
            continue
        incoming.update(member for member in group_members(obj) if member in groups)
    return [name for name in groups if name != "GLOBAL" and name not in incoming]


def discover_route_roots(groups, config, rules=None):
    mode = str(config.get("mode", "rule")).lower()
    if mode == "direct":
        return ["DIRECT"]
    if mode == "global":
        return ["GLOBAL"]

    roots = []
    if isinstance(rules, list):
        for rule in rules:
            if not isinstance(rule, dict):
                continue
            extra = rule.get("extra")
            if isinstance(extra, dict) and extra.get("disabled"):
                continue
            target = rule.get("proxy")
            if isinstance(target, str) and target and target not in roots:
                roots.append(target)
    return roots or structural_route_roots(groups)


def get_route_roots(groups):
    config = http_json("GET", "/configs")
    if not isinstance(config, dict):
        die("bad /configs response", EXIT_API_DOWN)
    rules = None
    if str(config.get("mode", "rule")).lower() == "rule":
        try:
            response = http_json("GET", "/rules")
            if isinstance(response, dict) and isinstance(response.get("rules"), list):
                rules = response["rules"]
        except Exception as error:
            print(
                f"warning: cannot read /rules; using structural roots: {error}",
                file=sys.stderr,
            )
    return discover_route_roots(groups, config, rules)


def plan_route_selection(root, groups):
    """Collect Selector edges without changing runtime state."""
    edges = []
    current = root
    seen = set()

    while True:
        if current in seen:
            die(f"cycle while traversing route at: {current}", EXIT_INVALID_INPUT)
        seen.add(current)
        obj = groups.get(current)
        if not is_selector(obj):
            return edges

        members = group_members(obj)
        if not members:
            die(f"Selector has no members: {current}", EXIT_NOT_FOUND)

        if len(members) == 1:
            member = members[0]
        else:
            options = []
            now = obj.get("now")
            for member_name in members:
                child = groups.get(member_name)
                child_type = (
                    f"  ({child.get('type')})" if is_group(child) else ""
                )
                marker = "* " if member_name == now else "  "
                options.append((f"{marker}{member_name}{child_type}", member_name))
            member = fzf_select_value(options, f"{current}> ")
            if member is None:
                raise SystemExit(EXIT_OK)

        if obj.get("now") != member:
            edges.append((current, member))
        child = groups.get(member)
        if not is_selector(child):
            return edges
        current = member


def apply_route_selection(edges, groups):
    """Apply validated Selector edges deepest-first; core owns persistence."""
    for group, member in edges:
        obj = validate_group_member(group, member, groups)
        if not is_selector(obj):
            die(f"route edge is not a Selector: {group}", EXIT_INVALID_INPUT)

    applied = []
    try:
        for group, member in reversed(edges):
            put_group_member(group, member)
            applied.append((group, member))
    except Exception:
        if applied:
            rendered = ", ".join(f"{group}->{member}" for group, member in applied)
            print(
                f"warning: route update was partial; applied: {rendered}",
                file=sys.stderr,
            )
        raise

    for group, member in applied:
        current = get_runtime_group(group)
        if current.get("now") != member:
            die(f"Mihomo did not select {member!r} in {group!r}", EXIT_GENERAL)


