def cmd_status(args):
    state = read_state()

    # Service section
    print("\033[1m── Service ──────────────\033[0m")
    try:
        subprocess.run(
            ["systemctl", "is-active", "--quiet", "mihomo.service"],
            check=True,
        )
        print("  status:     \033[32mactive\033[0m")
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("  status:     \033[31minactive\033[0m")

    try:
        version_data = http_json("GET", "/version")
        version = version_data.get("version", "unknown") if isinstance(version_data, dict) else "unknown"
        print(f"  version:    {version}")
    except Exception:
        print("  version:    \033[31munknown (API down)\033[0m")

    print(f"  mode:       {state.get('mode', 'tun')}")

    # Subscription section
    print()
    print("\033[1m── Subscription ─────────\033[0m")
    if SUB_URL.exists():
        sub_url = SUB_URL.read_text().strip()
        if sub_url:
            # Mask URL if too long
            display_url = sub_url if len(sub_url) <= 50 else sub_url[:47] + "..."
            print(f"  url:        {display_url}")

            # Check subscription age
            age_hours = (time.time() - SUB_URL.stat().st_mtime) / 3600
            if age_hours > 24:
                age_str = f"{int(age_hours)}h ago"
                print(f"  last update: \033[33m{age_str} (run: sudo mihomoctl sub update)\033[0m")
            else:
                if age_hours < 1:
                    age_str = f"{int(age_hours * 60)}m ago"
                else:
                    age_str = f"{int(age_hours)}h ago"
                print(f"  last update: {age_str}")
        else:
            print("  url:        \033[33mnot set\033[0m")
    else:
        print("  url:        \033[33mnot set\033[0m")

    # Routing section
    print()
    print("\033[1m── Routing ──────────────\033[0m")
    group = state.get("group")
    node = state.get("node")
    not_set = "\033[33mnot set\033[0m"
    print(f"  group:      {group or not_set}")
    print(f"  node:       {node or not_set}")

    # Network section
    print()
    print("\033[1m── Network ──────────────\033[0m")
    try:
        cfg = http_json("GET", "/configs")
        print(f"  api:        \033[32mok\033[0m (127.0.0.1:9090)")
        print(f"  mixed-port: {cfg.get('mixed-port')}")
        tun = cfg.get("tun") if isinstance(cfg.get("tun"), dict) else {}
        tun_enabled = tun.get("enable", False)
        if tun_enabled:
            print(f"  tun:        \033[32menabled\033[0m")
        else:
            print(f"  tun:        disabled")
    except Exception as e:
        print(f"  api:        \033[31mdown\033[0m ({e})")

    # Active proxy
    try:
        proxies = get_proxies()
        if group and group in proxies:
            now = proxies[group].get("now")
            if now:
                print()
                print(f"  active:     {group} -> {now}")
    except Exception:
        pass

    print()


def cmd_mode(args):
    state = read_state()

    if not args.value:
        print(state.get("mode", "tun"))
        return

    if args.value not in {"tun", "proxy"}:
        die("mode must be: tun or proxy", EXIT_INVALID_INPUT)

    need_root("changing mode")

    state["mode"] = args.value
    write_state(state)

    generate_config()

    subprocess.run(["systemctl", "restart", "mihomo.service"], check=True)

    print(f"mode switched to: {args.value}")


def validate_sub_url(url):
    """Validate subscription URL. Returns (ok: bool, message: str)."""
    try:
        req = urllib.request.Request(url, method="HEAD",
                                      headers={"User-Agent": "mihomo/1.0"})
        with urllib.request.urlopen(req, timeout=10) as r:
            return True, f"HTTP {r.status}"
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            return True, f"HTTP {e.code} (auth required, but URL exists)"
        return False, f"HTTP {e.code}"
    except Exception as e:
        return False, str(e)


def cmd_sub_set(args):
    need_root("setting subscription URL")

    if args.url:
        url = args.url
    else:
        url = getpass.getpass("Paste Mihomo/Clash subscription URL: ")

    if not url.startswith(("http://", "https://")):
        die("subscription URL must start with http:// or https://", EXIT_INVALID_INPUT)

    # Validate URL
    print("validating URL...", end="", flush=True)
    ok, msg = validate_sub_url(url)
    if ok:
        print(f"\r  \033[32m\033[1m✓\033[0m URL reachable ({msg})")
    else:
        print(f"\r  \033[31m\033[1m✗\033[0m URL unreachable ({msg})")
        if not sys.stdin.isatty():
            die("URL not reachable and running non-interactively", EXIT_INVALID_INPUT)
        answer = input("  Save anyway? [y/N] ").strip().lower()
        if answer not in ("y", "yes"):
            print("  aborted")
            raise SystemExit(EXIT_OK)

    ETC.mkdir(parents=True, exist_ok=True)
    SUB_URL.write_text(url.strip() + "\n")
    os.chmod(SUB_URL, 0o600)

    print(f"  saved: {SUB_URL}")


def cmd_sub_update(args):
    need_root("updating subscription")

    if not SUB_URL.exists():
        die("subscription URL missing. Run: sudo mihomoctl sub set", EXIT_NOT_FOUND)

    url = SUB_URL.read_text().strip()
    if not url:
        die("subscription URL is empty", EXIT_INVALID_INPUT)

    print("downloading subscription...")
    req = urllib.request.Request(url, headers={"User-Agent": "mihomo/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            content = r.read().decode()
    except urllib.error.URLError as e:
        die(f"download failed: {e}", EXIT_API_DOWN)

    data = yaml.safe_load(content)
    if not isinstance(data, dict):
        die("downloaded subscription is not a YAML object", EXIT_INVALID_INPUT)

    if not any(k in data for k in ("proxies", "proxy-providers", "proxy-groups", "rules")):
        print(content[:1000], file=sys.stderr)
        die("downloaded file does not look like a Mihomo/Clash YAML config", EXIT_INVALID_INPUT)

    BASE_CFG.write_text(content)
    os.chmod(BASE_CFG, 0o600)
    print(f"saved: {BASE_CFG}")

    generate_config()

    if subprocess.run(["systemctl", "is-active", "--quiet", "mihomo.service"]).returncode == 0:
        subprocess.run(["systemctl", "restart", "mihomo.service"], check=True)

    print("subscription updated")


