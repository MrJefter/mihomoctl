SUB_URL = ETC / "sub.url"
BASE_CFG = ETC / "base.yaml"
CFG = ETC / "config.yaml"
CAPTURE_MODE = ETC / "capture-mode"
EXTRA_RULES = ETC / "extra-rules.yaml"

CONTROLLER = os.environ.get("MIHOMOCTL_CONTROLLER", "http://127.0.0.1:9090").rstrip("/")
DEFAULT_MIHOMO_BIN = Path(__file__).resolve().with_name("mihomo")
MIHOMO_BIN = os.environ.get("MIHOMOCTL_MIHOMO_BIN") or (
    str(DEFAULT_MIHOMO_BIN)
    if DEFAULT_MIHOMO_BIN.exists()
    else shutil.which("mihomo") or "/usr/local/bin/mihomo"
)
SYSTEMCTL = os.environ.get("MIHOMOCTL_SYSTEMCTL", "systemctl")
