#!/usr/bin/env python3
import argparse
import getpass
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

import yaml

ETC = Path("/etc/mihomo")
VAR = Path("/var/lib/mihomoctl")

SUB_URL = ETC / "sub.url"
BASE_CFG = ETC / "base.yaml"
CFG = ETC / "config.yaml"
STATE = VAR / "state.json"

CONTROLLER = "http://127.0.0.1:9090"
MIXED_PORT = 7890

# Exit codes
EXIT_OK = 0
EXIT_GENERAL = 1
EXIT_NOT_FOUND = 2
EXIT_API_DOWN = 3
EXIT_AUTH_FAILED = 4
EXIT_INVALID_INPUT = 5
EXIT_DEPENDENCY = 6

GROUP_TYPES = {
    "selector", "select",
}

NON_NODE_NAMES = {
    "DIRECT", "REJECT", "REJECT-DROP", "PASS", "COMPATIBLE",
}


def die(msg, code=EXIT_GENERAL):
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def need_root(action):
    if os.geteuid() != 0:
        die(f"{action} needs root. Run: sudo mihomoctl ...", EXIT_DEPENDENCY)


def read_state():
    if not STATE.exists():
        return {"mode": "tun", "group": None, "node": None}
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {"mode": "tun", "group": None, "node": None}


def write_state(state):
    VAR.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n")


def load_yaml(path):
    if not path.exists():
        die(f"{path} does not exist", EXIT_NOT_FOUND)
    data = yaml.safe_load(path.read_text()) or {}
    if not isinstance(data, dict):
        die(f"{path} is not a YAML object", EXIT_INVALID_INPUT)
    return data


def save_yaml(path, data):
    path.write_text(
        yaml.safe_dump(
            data,
            allow_unicode=True,
            sort_keys=False,
            default_flow_style=False,
        )
    )


def generate_config():
    need_root("generating config")

    state = read_state()
    mode = state.get("mode") or "tun"

    cfg = load_yaml(BASE_CFG)

    cfg["mixed-port"] = MIXED_PORT
    cfg["allow-lan"] = False
    cfg["mode"] = cfg.get("mode", "rule")
    cfg["log-level"] = cfg.get("log-level", "info")

    cfg["external-controller"] = "127.0.0.1:9090"
    cfg["secret"] = ""

    profile = cfg.get("profile")
    if not isinstance(profile, dict):
        profile = {}
    profile["store-selected"] = True
    profile.setdefault("store-fake-ip", True)
    cfg["profile"] = profile

    tun = cfg.get("tun")
    if not isinstance(tun, dict):
        tun = {}

    tun["enable"] = mode == "tun"
    tun["stack"] = "gvisor"
    tun.setdefault("auto-route", True)
    tun.setdefault("auto-detect-interface", True)
    tun["strict-route"] = False

    if mode == "tun":
        tun["dns-hijack"] = ["any:53"]
    else:
        tun.pop("dns-hijack", None)

    fake_excludes = {
        "198.18.0.0/15",
        "198.18.0.0/16",
        "198.19.0.0/16",
        "198.18.0.0/24",
        "198.18.0.0/30",
    }

    excludes = tun.get("route-exclude-address")
    if isinstance(excludes, list):
        tun["route-exclude-address"] = [
            x for x in excludes
            if str(x).strip() not in fake_excludes
        ]

    cfg["tun"] = tun

    cfg["ipv6"] = False

    # Apply DNS overrides from state
    dns_overrides = state.get("dns", {})

    dns = cfg.get("dns")
    if not isinstance(dns, dict):
        dns = {}

    dns["enable"] = True
    dns["ipv6"] = False

    # Apply enhanced-mode override
    enhanced_mode = dns_overrides.get("enhanced-mode", "redir-host")
    dns["enhanced-mode"] = enhanced_mode

    dns.pop("fake-ip-range", None)
    dns.setdefault("default-nameserver", ["1.1.1.1", "8.8.8.8"])

    # Apply nameserver overrides
    if "nameservers" in dns_overrides:
        dns["nameserver"] = dns_overrides["nameservers"]
    else:
        dns.setdefault("nameserver", [
            "https://1.1.1.1/dns-query",
            "https://8.8.8.8/dns-query"
        ])

    # Apply fallback overrides
    if "fallback" in dns_overrides:
        dns["fallback"] = dns_overrides["fallback"]
    else:
        dns.setdefault("fallback", [
            "https://1.0.0.1/dns-query",
            "https://8.8.4.4/dns-query"
        ])

    dns.setdefault("fake-ip-filter", [
        "*.lan",
        "*.local",
        "localhost.ptlogin2.qq.com",
        "dns.msftncsi.com",
        "www.msftncsi.com",
        "time.*.com",
        "time.*.gov",
        "time.*.edu.cn",
        "time.*.apple.com",
        "time-ios.apple.com",
        "time1.*.com",
        "time2.*.com",
        "time3.*.com",
        "time4.*.com",
        "time5.*.com",
        "time6.*.com",
        "time7.*.com",
        "ntp.*.com",
        "ntp1.*.com",
        "ntp2.*.com",
        "ntp3.*.com",
        "ntp4.*.com",
        "ntp5.*.com",
        "ntp6.*.com",
        "ntp7.*.com"
    ])

    if dns.get("enhanced-mode") == "redir-host":
        dns.pop("fake-ip-range", None)
        dns.pop("fake-ip-filter", None)

    cfg["dns"] = dns

    ETC.mkdir(parents=True, exist_ok=True)
    save_yaml(CFG, cfg)

    subprocess.run(["/usr/local/bin/mihomo", "-t", "-d", str(ETC)], check=True)
    print(f"generated {CFG} mode={mode}")


def http_json(method, path, body=None, timeout=8):
    url = CONTROLLER + path
    data = None
    headers = {}

    if body is not None:
        data = json.dumps(body, ensure_ascii=False).encode()
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)

    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read()
        if not raw:
            return None
        return json.loads(raw.decode())


def wait_api(timeout=20):
    end = time.time() + timeout
    last = None
    while time.time() < end:
        try:
            return http_json("GET", "/version")
        except Exception as e:
            last = e
            time.sleep(0.5)
    die(f"mihomo API is not responding at {CONTROLLER}: {last}", EXIT_API_DOWN)


def get_proxies():
    wait_api()
    data = http_json("GET", "/proxies")
    proxies = data.get("proxies") if isinstance(data, dict) else None
    if not isinstance(proxies, dict):
        die("bad /proxies response", EXIT_API_DOWN)
    return proxies


def group_members(obj):
    for key in ("all", "proxies"):
        val = obj.get(key)
        if isinstance(val, list):
            return val
    return []


def is_group(obj):
    return isinstance(obj, dict) and len(group_members(obj)) > 0


def is_selector(obj):
    if not is_group(obj):
        return False
    t = str(obj.get("type", "")).lower()
    return t in GROUP_TYPES or "selector" in t or "select" in t


def is_node_name(name, proxies):
    if name in NON_NODE_NAMES:
        return False
    obj = proxies.get(name)
    if not isinstance(obj, dict):
        return True
    if is_group(obj):
        return False
    t = str(obj.get("type", "")).lower()
    if t in {"direct", "reject"}:
        return False
    return True


def candidate_groups(proxies):
    groups = []
    for name, obj in proxies.items():
        if is_selector(obj):
            nodes = [x for x in group_members(obj) if is_node_name(x, proxies)]
            if nodes:
                groups.append((name, obj, nodes))
    return groups


def all_groups(proxies):
    groups = []
    for name, obj in proxies.items():
        if is_group(obj):
            nodes = [x for x in group_members(obj) if is_node_name(x, proxies)]
            if nodes:
                groups.append((name, obj, nodes))
    return groups


def get_group_nodes(group, proxies):
    obj = proxies.get(group)
    if not is_group(obj):
        die(f"not a proxy group: {group}", EXIT_NOT_FOUND)

    nodes = group_members(obj)
    if not nodes:
        die(f"group has no selectable nodes: {group}", EXIT_NOT_FOUND)
    return nodes


def select_node(group, node):
    path = "/proxies/" + urllib.parse.quote(group, safe="")
    http_json("PUT", path, {"name": node})
    print(f"selected: {group} -> {node}")


def fzf_select(items, prompt):
    if shutil.which("fzf"):
        p = subprocess.run(
            ["fzf", "--prompt", prompt],
            input="\n".join(items) + "\n",
            text=True,
            stdout=subprocess.PIPE,
        )
        result = p.stdout.strip()
        return result if result else None
    else:
        for i, item in enumerate(items, 1):
            print(f"{i:2d}) {item}")
        try:
            idx = int(input("number: "))
            if 1 <= idx <= len(items):
                return items[idx - 1]
        except (ValueError, EOFError):
            pass
        return None


def cmd_node_pick(args):
    proxies = get_proxies()
    state = read_state()

    group = state.get("group")
    if not group:
        die("no default group set. Run: mihomoctl node group", EXIT_NOT_FOUND)

    nodes = get_group_nodes(group, proxies)
    now = proxies[group].get("now", "")

    items = []
    for n in nodes:
        prefix = "* " if n == now else "  "
        items.append(f"{prefix}{n}")

    result = fzf_select(items, f"{group}> ")
    if not result:
        raise SystemExit(EXIT_OK)

    node = result.lstrip("* ").strip()

    select_node(group, node)

    state["node"] = node
    write_state(state)


def test_node_latency(group, node):
    """Returns latency in ms or None on timeout."""
    try:
        path = f"/proxies/{urllib.parse.quote(group, safe='')}/delay"
        params = f"timeout=5000&url=http://www.gstatic.com/generate_204&target={urllib.parse.quote(node, safe='')}"
        data = http_json("GET", f"{path}?{params}")
        return data.get("delay")
    except Exception:
        return None


def cmd_node_test(args):
    state = read_state()
    group = state.get("group")
    if not group:
        die("no default group set. Run: mihomoctl node group", EXIT_NOT_FOUND)

    proxies = get_proxies()

    if args.all:
        nodes = get_group_nodes(group, proxies)
    else:
        current = proxies[group].get("now")
        if not current:
            die("no node selected in group", EXIT_NOT_FOUND)
        nodes = [current]

    # Test nodes with progress indicator
    results = []
    if args.all:
        print(f"\n  Testing {len(nodes)} nodes in {group}...")
        for i, node in enumerate(nodes, 1):
            sys.stdout.write(f"\r  [{i}/{len(nodes)}] {node}...")
            sys.stdout.flush()
            latency = test_node_latency(group, node)
            results.append((node, latency))
        sys.stdout.write("\r" + " " * 50 + "\r")
        sys.stdout.flush()
    else:
        node = nodes[0]
        sys.stdout.write(f"\r  Testing {node}...")
        sys.stdout.flush()
        latency = test_node_latency(group, node)
        results.append((node, latency))
        sys.stdout.write("\r" + " " * 50 + "\r")
        sys.stdout.flush()

    if not results:
        die("no results", EXIT_GENERAL)

    # Show results in fzf or formatted table
    if args.all and shutil.which("fzf"):
        items = []
        for node, lat in results:
            lat_str = f"{lat}ms" if lat else "timeout"
            marker = "* " if node == proxies[group].get("now") else "  "
            items.append(f"{marker}{node:<30} {lat_str:>10}")
        # Sort: timeouts last, then by latency
        items.sort(key=lambda x: ("timeout" in x, x))

        p = subprocess.run(
            ["fzf", "--prompt", f"{group} results> ", "--no-sort"],
            input="\n".join(items) + "\n",
            text=True,
            stdout=subprocess.PIPE,
        )
    else:
        # Fallback: formatted table
        results.sort(key=lambda x: x[1] if x[1] else float('inf'))
        print(f"\n  {'node':<30} {'latency':>10}")
        print(f"  {'-'*42}")
        for node, lat in results:
            lat_str = f"{lat}ms" if lat else "timeout"
            marker = "* " if node == proxies[group].get("now") else "  "
            print(f"  {marker}{node:<28} {lat_str:>10}")
    print()


def cmd_node_group(args):
    proxies = get_proxies()
    state = read_state()

    groups = all_groups(proxies)
    if not groups:
        die("no proxy groups found", EXIT_NOT_FOUND)

    items = []
    for name, obj, nodes in groups:
        prefix = "* " if name == state.get("group") else "  "
        t = str(obj.get("type", "")).lower()
        items.append(f"{prefix}{name}  ({t}, {len(nodes)} nodes)")

    result = fzf_select(items, "group> ")
    if not result:
        raise SystemExit(EXIT_OK)

    group = result.split("  ")[0].lstrip("* ").strip()

    # Pick node within group
    nodes = [x for x in group_members(proxies[group]) if is_node_name(x, proxies)]
    if not nodes:
        die(f"group has no selectable nodes: {group}", EXIT_NOT_FOUND)

    node_items = []
    current = proxies[group].get("now", "")
    for n in nodes:
        prefix = "* " if n == current else "  "
        node_items.append(f"{prefix}{n}")

    node_result = fzf_select(node_items, f"{group}> ")
    if not node_result:
        raise SystemExit(EXIT_OK)

    node = node_result.lstrip("* ").strip()

    select_node(group, node)

    state["group"] = group
    state["node"] = node
    write_state(state)


