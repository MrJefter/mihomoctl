        if not roots:
            die("no selectable route roots found", EXIT_NOT_FOUND)
        if len(roots) == 1:
            root = roots[0]
        else:
            options = []
            for root_name in roots:
                obj = groups[root_name]
                options.append((format_group_resolution(root_name, obj, groups), root_name))
            root = fzf_select_value(options, "route root> ")
