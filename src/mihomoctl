def redact_url(url):
    """Show only subscription origin; paths and query strings often hold tokens."""
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme in {"http", "https"} and parsed.hostname:
        host = parsed.hostname
        if ":" in host and not host.startswith("["):
            host = f"[{host}]"
        try:
            port = parsed.port
        except ValueError:
            return "configured"
        if port:
            host = f"{host}:{port}"
        return f"{parsed.scheme}://{host}/…"
    return "configured"


