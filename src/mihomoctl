#!/usr/bin/env python3
import argparse
import getpass
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

import yaml

ETC = Path("/etc/mihomo")
VAR = Path("/var/lib/mihomoctl")

SUB_URL = ETC / "sub.url"
BASE_CFG = ETC / "base.yaml"
CFG = ETC / "config.yaml"
STATE = VAR / "state.json"

CONTROLLER = "http://127.0.0.1:9090"
MIXED_PORT = 7890

# Exit codes
EXIT_OK = 0
EXIT_GENERAL = 1
EXIT_NOT_FOUND = 2
EXIT_API_DOWN = 3
EXIT_AUTH_FAILED = 4
EXIT_INVALID_INPUT = 5
EXIT_DEPENDENCY = 6

GROUP_TYPES = {
    "selector", "select",
}

NON_NODE_NAMES = {
    "DIRECT", "REJECT", "REJECT-DROP", "PASS", "COMPATIBLE",
}


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def need_root(action):
    if os.geteuid() != 0:
        die(f"{action} needs root. Run: sudo mihomoctl ...", EXIT_DEPENDENCY)


def read_state():
    if not STATE.exists():
        return {"mode": "tun", "group": None, "node": None, "profile": None}
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {"mode": "tun", "group": None, "node": None, "profile": None}


def write_state(state):
    VAR.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n")


def load_yaml(path):
    if not path.exists():
        die(f"{path} does not exist", EXIT_NOT_FOUND)
    data = yaml.safe_load(path.read_text()) or {}
    if not isinstance(data, dict):
        die(f"{path} is not a YAML object", EXIT_INVALID_INPUT)
    return data


def save_yaml(path, data):
    path.write_text(
        yaml.safe_dump(
            data,
            allow_unicode=True,
            sort_keys=False,
            default_flow_style=False,
        )
    )


def generate_config():
    need_root("generating config")

    state = read_state()
    mode = state.get("mode") or "tun"

    cfg = load_yaml(BASE_CFG)

    cfg["mixed-port"] = MIXED_PORT
    cfg["allow-lan"] = False
    cfg["mode"] = cfg.get("mode", "rule")
    cfg["log-level"] = cfg.get("log-level", "info")

    cfg["external-controller"] = "127.0.0.1:9090"
    cfg["secret"] = ""

    profile = cfg.get("profile")
    if not isinstance(profile, dict):
        profile = {}
    profile["store-selected"] = True
    profile.setdefault("store-fake-ip", True)
    cfg["profile"] = profile

    tun = cfg.get("tun")
    if not isinstance(tun, dict):
        tun = {}

    tun["enable"] = mode == "tun"
    tun["stack"] = "gvisor"
    tun.setdefault("auto-route", True)
    tun.setdefault("auto-detect-interface", True)
    tun["strict-route"] = False

    if mode == "tun":
        tun["dns-hijack"] = ["any:53"]
    else:
        tun.pop("dns-hijack", None)

    fake_excludes = {
        "198.18.0.0/15",
        "198.18.0.0/16",
        "198.19.0.0/16",
        "198.18.0.0/24",
        "198.18.0.0/30",
    }

    excludes = tun.get("route-exclude-address")
    if isinstance(excludes, list):
        tun["route-exclude-address"] = [
            x for x in excludes
            if str(x).strip() not in fake_excludes
        ]

    cfg["tun"] = tun

    cfg["ipv6"] = False

    dns = cfg.get("dns")
    if not isinstance(dns, dict):
        dns = {}

    dns["enable"] = True
    dns["ipv6"] = False
    dns["enhanced-mode"] = "redir-host"
    dns.pop("fake-ip-range", None)
    dns.setdefault("default-nameserver", ["1.1.1.1", "8.8.8.8"])
    dns.setdefault("nameserver", [
        "https://1.1.1.1/dns-query",
        "https://8.8.8.8/dns-query"
    ])
    dns.setdefault("fallback", [
        "https://1.0.0.1/dns-query",
        "https://8.8.4.4/dns-query"
    ])
    dns.setdefault("fake-ip-filter", [
        "*.lan",
        "*.local",
        "localhost.ptlogin2.qq.com",
        "dns.msftncsi.com",
        "www.msftncsi.com",
        "time.*.com",
        "time.*.gov",
        "time.*.edu.cn",
        "time.*.apple.com",
        "time-ios.apple.com",
        "time1.*.com",
        "time2.*.com",
        "time3.*.com",
        "time4.*.com",
        "time5.*.com",
        "time6.*.com",
        "time7.*.com",
        "ntp.*.com",
        "ntp1.*.com",
        "ntp2.*.com",
        "ntp3.*.com",
        "ntp4.*.com",
        "ntp5.*.com",
        "ntp6.*.com",
        "ntp7.*.com"
    ])

    if dns.get("enhanced-mode") == "redir-host":
        dns.pop("fake-ip-range", None)
        dns.pop("fake-ip-filter", None)

    cfg["dns"] = dns

    ETC.mkdir(parents=True, exist_ok=True)
    save_yaml(CFG, cfg)

    subprocess.run(["/usr/local/bin/mihomo", "-t", "-d", str(ETC)], check=True)
    print(f"generated {CFG} mode={mode}")


def http_json(method, path, body=None, timeout=8):
    url = CONTROLLER + path
    data = None
    headers = {}

    if body is not None:
        data = json.dumps(body, ensure_ascii=False).encode()
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)

    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read()
        if not raw:
            return None
        return json.loads(raw.decode())


def wait_api(timeout=20):
    end = time.time() + timeout
    last = None
    while time.time() < end:
        try:
            return http_json("GET", "/version")
        except Exception as e:
            last = e
            time.sleep(0.5)
    die(f"mihomo API is not responding at {CONTROLLER}: {last}", EXIT_API_DOWN)


def get_proxies():
    wait_api()
    data = http_json("GET", "/proxies")
    proxies = data.get("proxies") if isinstance(data, dict) else None
    if not isinstance(proxies, dict):
        die("bad /proxies response", EXIT_API_DOWN)
    return proxies


def is_group(obj):
    return isinstance(obj, dict) and isinstance(obj.get("all"), list)


def is_selector(obj):
    if not is_group(obj):
        return False
    t = str(obj.get("type", "")).lower()
    return t in GROUP_TYPES or "selector" in t or "select" in t


def is_node_name(name, proxies):
    if name in NON_NODE_NAMES:
        return False
    obj = proxies.get(name)
    if not isinstance(obj, dict):
        return True
    if is_group(obj):
        return False
    t = str(obj.get("type", "")).lower()
    if t in {"direct", "reject"}:
        return False
    return True


def candidate_groups(proxies):
    groups = []
    for name, obj in proxies.items():
        if is_selector(obj):
            nodes = [x for x in obj.get("all", []) if is_node_name(x, proxies)]
            if nodes:
                groups.append((name, obj, nodes))
    return groups


def get_group_nodes(group, proxies):
    obj = proxies.get(group)
    if not is_group(obj):
        die(f"not a proxy group: {group}", EXIT_NOT_FOUND)

    nodes = [x for x in obj.get("all", []) if is_node_name(x, proxies)]
    if not nodes:
        die(f"group has no selectable nodes: {group}", EXIT_NOT_FOUND)
    return nodes


def select_node(group, node):
    path = "/proxies/" + urllib.parse.quote(group, safe="")
    http_json("PUT", path, {"name": node})
    print(f"selected: {group} -> {node}")


def fzf_select(items, prompt):
    if shutil.which("fzf"):
        p = subprocess.run(
            ["fzf", "--prompt", prompt],
            input="\n".join(items) + "\n",
            text=True,
            stdout=subprocess.PIPE,
        )
        result = p.stdout.strip()
        return result if result else None
    else:
        for i, item in enumerate(items, 1):
            print(f"{i:2d}) {item}")
        try:
            idx = int(input("number: "))
            if 1 <= idx <= len(items):
                return items[idx - 1]
        except (ValueError, EOFError):
            pass
        return None


def cmd_node_pick(args):
    proxies = get_proxies()
    state = read_state()

    group = state.get("group")
    if not group:
        die("no default group set. Run: mihomoctl group pick", EXIT_NOT_FOUND)

    nodes = get_group_nodes(group, proxies)
    now = proxies[group].get("now", "")

    items = []
    for n in nodes:
        prefix = "* " if n == now else "  "
        items.append(f"{prefix}{n}")

    result = fzf_select(items, f"{group}> ")
    if not result:
        raise SystemExit(1)

    node = result.lstrip("* ").strip()

    select_node(group, node)

    state["node"] = node
    write_state(state)


def cmd_group_pick(args):
    proxies = get_proxies()
    state = read_state()

    groups = candidate_groups(proxies)
    if not groups:
        die("no selectable proxy groups found", EXIT_NOT_FOUND)

    items = []
    for name, obj, nodes in groups:
        prefix = "* " if name == state.get("group") else "  "
        now = obj.get("now", "")
        items.append(f"{prefix}{name}  ({len(nodes)} nodes, now={now})")

    result = fzf_select(items, "group> ")
    if not result:
        raise SystemExit(1)

    group = result.split("  ")[0].lstrip("* ").strip()

    state["group"] = group
    write_state(state)
    print(f"default group: {group}")


def cmd_group_profile(args):
    proxies = get_proxies()
    state = read_state()

    groups = candidate_groups(proxies)
    if not groups:
        die("no selectable proxy groups found", EXIT_NOT_FOUND)

    items = []
    for name, obj, nodes in groups:
        prefix = "* " if name == state.get("profile") else "  "
        now = obj.get("now", "")
        items.append(f"{prefix}{name}  (now={now})")

    result = fzf_select(items, "profile> ")
    if not result:
        raise SystemExit(1)

    profile = result.split("  ")[0].lstrip("* ").strip()

    sub_items = []
    obj = proxies.get(profile)
    if is_group(obj):
        for n in obj.get("all", []):
            now_mark = "* " if n == obj.get("now") else "  "
            sub_items.append(f"{now_mark}{n}")

    if not sub_items:
        die(f"no selectable options in profile: {profile}", EXIT_NOT_FOUND)

    sub_result = fzf_select(sub_items, f"{profile}> ")
    if not sub_result:
        raise SystemExit(1)

    node = sub_result.lstrip("* ").strip()

    select_node(profile, node)

    state["profile"] = profile
    write_state(state)


def cmd_enable(args):
    need_root("enabling mihomo")
    subprocess.run(["systemctl", "enable", "--now", "mihomo.service"], check=True)
    print("mihomo enabled and started")


def cmd_disable(args):
    need_root("disabling mihomo")
    subprocess.run(["systemctl", "disable", "--now", "mihomo.service"], check=True)
    print("mihomo stopped and disabled")


def cmd_status(args):
    state = read_state()

    print(f"mode:       {state.get('mode', 'tun')}")
    print(f"group:      {state.get('group')}")
    print(f"node:       {state.get('node')}")
    print(f"profile:    {state.get('profile')}")
    print()

    try:
        subprocess.run(
            ["systemctl", "is-active", "--quiet", "mihomo.service"],
            check=True,
        )
        print("service:    active")
    except subprocess.CalledProcessError:
        print("service:    inactive")

    try:
        cfg = http_json("GET", "/configs")
        print("api:        ok")
        print(f"mixed-port: {cfg.get('mixed-port')}")
        print(f"mode:       {cfg.get('mode')}")
        tun = cfg.get("tun") if isinstance(cfg.get("tun"), dict) else {}
        print(f"tun.enable: {tun.get('enable')}")
    except Exception as e:
        print(f"api:        down ({e})")

    try:
        proxies = get_proxies()
        group = state.get("group")
        if group and group in proxies:
            now = proxies[group].get("now")
            print(f"active:     {group} -> {now}")
    except Exception as e:
        print(f"proxies:    unavailable ({e})")


def cmd_mode(args):
    state = read_state()

    if not args.value:
        print(state.get("mode", "tun"))
        return

    if args.value not in {"tun", "proxy"}:
        die("mode must be: tun or proxy", EXIT_INVALID_INPUT)

    need_root("changing mode")

    state["mode"] = args.value
    write_state(state)

    generate_config()

    subprocess.run(["systemctl", "restart", "mihomo.service"], check=True)

    print(f"mode switched to: {args.value}")


def cmd_sub_set(args):
    need_root("setting subscription URL")

    if args.url:
        url = args.url
    else:
        url = getpass.getpass("Paste Mihomo/Clash subscription URL: ")

    if not url.startswith(("http://", "https://")):
        die("subscription URL must start with http:// or https://", EXIT_INVALID_INPUT)

    ETC.mkdir(parents=True, exist_ok=True)
    SUB_URL.write_text(url.strip() + "\n")
    os.chmod(SUB_URL, 0o600)

    print(f"saved: {SUB_URL}")


def cmd_sub_update(args):
    need_root("updating subscription")

    if not SUB_URL.exists():
        die("subscription URL missing. Run: sudo mihomoctl sub set", EXIT_NOT_FOUND)

    url = SUB_URL.read_text().strip()
    if not url:
        die("subscription URL is empty", EXIT_INVALID_INPUT)

    print("downloading subscription...")
    req = urllib.request.Request(url, headers={"User-Agent": "mihomo/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            content = r.read().decode()
    except urllib.error.URLError as e:
        die(f"download failed: {e}", EXIT_API_DOWN)

    data = yaml.safe_load(content)
    if not isinstance(data, dict):
        die("downloaded subscription is not a YAML object", EXIT_INVALID_INPUT)

    if not any(k in data for k in ("proxies", "proxy-providers", "proxy-groups", "rules")):
        print(content[:1000], file=sys.stderr)
        die("downloaded file does not look like a Mihomo/Clash YAML config", EXIT_INVALID_INPUT)

    BASE_CFG.write_text(content)
    os.chmod(BASE_CFG, 0o600)
    print(f"saved: {BASE_CFG}")

    generate_config()

    if subprocess.run(["systemctl", "is-active", "--quiet", "mihomo.service"]).returncode == 0:
        subprocess.run(["systemctl", "restart", "mihomo.service"], check=True)

    print("subscription updated")


def cmd_restart(args):
    need_root("restarting mihomo")
    subprocess.run(["systemctl", "restart", "mihomo.service"], check=True)
    print("mihomo restarted")


def cmd_logs(args):
    try:
        subprocess.run(["journalctl", "-u", "mihomo.service", "-f", "-o", "cat"])
    except KeyboardInterrupt:
        print()
        return


def main():
    p = argparse.ArgumentParser(prog="mihomoctl")

    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status").set_defaults(fn=cmd_status)

    g = sub.add_parser("group")
    gsub = g.add_subparsers(dest="group_cmd", required=True)
    gsub.add_parser("pick").set_defaults(fn=cmd_group_pick)
    gsub.add_parser("profile").set_defaults(fn=cmd_group_profile)

    n = sub.add_parser("node")
    nsub = n.add_subparsers(dest="node_cmd", required=True)
    nsub.add_parser("pick").set_defaults(fn=cmd_node_pick)

    sub.add_parser("enable").set_defaults(fn=cmd_enable)
    sub.add_parser("disable").set_defaults(fn=cmd_disable)

    m = sub.add_parser("mode")
    m.add_argument("value", nargs="?")
    m.set_defaults(fn=cmd_mode)

    s = sub.add_parser("sub")
    ssub = s.add_subparsers(dest="sub_cmd", required=True)

    ss = ssub.add_parser("set")
    ss.add_argument("url", nargs="?")
    ss.set_defaults(fn=cmd_sub_set)

    su = ssub.add_parser("update")
    su.set_defaults(fn=cmd_sub_update)

    sub.add_parser("restart").set_defaults(fn=cmd_restart)
    sub.add_parser("logs").set_defaults(fn=cmd_logs)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
